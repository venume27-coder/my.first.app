{
  "name": "slidenova-promo",
  "version": "1.0.0",
  "private": true,
  "description": "Вертикальный промо-ролик для Telegram-бота @SlideNovaBot на Remotion",
  "scripts": {
    "start": "remotion studio",
    "build": "remotion render SlideNovaPromo out/slidenova-promo.mp4",
    "stills": "node scripts/stills.mjs",
    "typecheck": "tsc --noEmit",
    "music": "python3 scripts/make_music.py"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.529",
    "@remotion/cli": "4.0.529",
    "@remotion/google-fonts": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
